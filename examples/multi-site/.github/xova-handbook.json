{
  "schemaVersion": 1,
  "docs": {
    "provider": "cloudflare",
    "check-command": "npm run docs:check --workspace=handbook",
    "build-command": "npm run docs:build --workspace=handbook",
    "site-directory": "sites/handbook/dist",
    "site-id": "handbook",
    "environment-name": "docs-handbook",
    "deploy-command": "npm exec --no -- wrangler deploy --config sites/handbook/wrangler.jsonc",
    "deployment-policy": "always"
  }
}
